@inproceedings{10.1145/3813822.3813916,
author = {Zhang, Yanfeng and Jiang, Rui and Pei, Bei and Chen, Guangyong},
title = {A Lightweight Certificateless Anonymous Authentication and Key Agreement Scheme for the Internet of Vehicles},
year = {2026},
isbn = {9798400722578},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3813822.3813916},
doi = {10.1145/3813822.3813916},
abstract = {Reliable vehicle–infrastructure interaction in the Internet of Vehicles (IoV) depends on fast, privacy-aware authentication over insecure wireless channels. Conventional PKI solutions introduce certificate-processing overhead, whereas identity-based approaches reduce certificate cost at the expense of key escrow. To balance security and efficiency, we present LCA-AKA, a lightweight certificateless anonymous authentication and key-agreement protocol for V2I scenarios. Under the Dolev–Yao adversarial setting and strand-space authentication tests, the protocol provides mutual authentication, resistance to replay and impersonation attacks, session-key confidentiality, anonymity, and forward secrecy. Performance results show low online computation and communication cost, indicating suitability for high-mobility and resource-limited IoV deployments.},
booktitle = {Proceedings of the 2026 7th International Conference on Computer Information and Big Data Applications},
pages = {565–570},
numpages = {6},
keywords = {Internet of Vehicles, certificateless cryptography, anonymous authentication, key agreement},
location = {
},
series = {CIBDA '26}
}

