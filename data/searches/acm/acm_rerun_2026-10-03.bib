@inproceedings{10.1145/3770855.3818649,
author = {Sultimov, Roman and Efimov, Daniil and Kuzin, Mikhail and Novikov, Ivan and Dvoryankov, Roman and Suraveikin, Egor},
title = {Episode Spaces: Mining Reusable Knowledge from Urban Simulation Corpora for Safety-Critical Decision Support},
year = {2026},
isbn = {9798400722592},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3770855.3818649},
doi = {10.1145/3770855.3818649},
abstract = {End-to-end reinforcement learning has advanced urban traffic management yet it exhibits dangerous fragility in safety-critical scenarios: a PPO-trained evacuation coordinator achieves 92.5% evacuation rate in-distribution but collapses to 32.7% under a compound distribution shift that simultaneously changes hazard origin and road topology. We argue that the response is not to train bigger models but to mine structured knowledge from simulation corpora. We introduce episode spaces: indexed, queryable libraries of complete context-action-outcome decision episodes extracted from simulation runs. A lightweight retrieval-and-repair mechanism adapts stored episodes to novel situations, recovering 92.4% under topology disruption and 74.3% under compound shift. On a richer five-zone benchmark, retrieval-only coordination achieves 69.8% where PPO degrades to 49.3%. We formalize episode spaces, present preliminary evidence from two SUMO-based benchmarks, identify five research frontiers, define measurable success criteria for this agenda.},
booktitle = {Proceedings of the 32nd ACM SIGKDD Conference on Knowledge Discovery and Data Mining V.2},
pages = {13219–13224},
numpages = {6},
keywords = {episode spaces, urban evacuation, safety-critical ai},
location = {Republic of Korea},
series = {KDD '26}
}

@inproceedings{10.1145/3820915.3821025,
author = {Yang, Chunyang},
title = {VR Landscape Sketching Composition Intelligent Assistance System Based on Reinforcement Learning PPO Algorithm},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821025},
doi = {10.1145/3820915.3821025},
abstract = {Mastering spatial composition in Virtual Reality (VR) landscape sketching poses a significant challenge for beginners, as traditional rule-based assistance systems often fail to capture subjective human aesthetics. To bridge the gap between computational geometry and artistic intuition, this paper proposes a novel intelligent VR composition assistance system integrating Proximal Policy Optimization (PPO) with Reinforcement Learning from Human Feedback (RLHF). We formulate the continuous 6-Degree-of-Freedom (6-DoF) camera manipulation as a Markov Decision Process, enabling the agent to dynamically explore optimal viewpoints. By incorporating an RLHF module, the system aligns its reward function with the aesthetic preferences of expert art teachers, overcoming the limitations of rigid heuristic rules. Extensive experiments demonstrate that our PPO+RLHF framework achieves a 21% faster convergence rate and significantly higher cumulative rewards compared to standard Asynchronous Advantage Actor-Critic (A3C) baselines. Furthermore, the system maintains an ultra-low inference latency of under 18 ms, ensuring a seamless 90 Hz VR experience without motion sickness. A two-week user study involving 30 novices reveals that the proposed system improves users' composition scores by 42% and reduces the training time required to reach artistic proficiency by 30%. These results highlight the system's exceptional efficacy in lowering the learning threshold for 3D composition and advancing intelligent art education.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {717–722},
numpages = {6},
location = {
},
series = {AIVRID '26}
}

