@inproceedings{10.1145/3809986.3809998,
author = {Wu, Yuqi and Yuan, Ye and Chen, Qushuo and Li, Jiachen and Pan, Xiaoyong},
title = {DGRNA: a long-context RNA foundation model with bidirectional attention Mamba2},
year = {2026},
isbn = {9798400721946},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3809986.3809998},
doi = {10.1145/3809986.3809998},
abstract = {Ribonucleic acids (RNAs) are fundamental biomolecules that play diverse roles in biological systems, such as mediating genetic information flow, regulating gene expression, and supporting various cellular processes. Recent advances in high-throughput sequencing have made large-scale RNA datasets widely accessible, substantially enhancing our understanding of RNA biology and facilitating the development of RNA-based therapeutics. To exploit these data at scale, recent studies have adopted representation-learning frameworks, with unsupervised language models playing a central role in extracting latent features from RNA sequences. Most current RNA language models are built upon Transformer-based designs, whose computational cost grows quadratically with sequence length, limiting their scalability on long RNA inputs. By comparison, the Mamba architecture provides a more efficient framework that is better suited for long-sequence modeling. We propose DGRNA, a large-scale RNA foundation model that adopts a bidirectional Mamba-based design and is trained on a corpus of 100 million RNA sequences. Extensive evaluations show that DGRNA consistently outperforms prior RNA language models across six downstream RNA tasks.},
booktitle = {Proceedings of the 2026 6th International Conference on Bioinformatics and Intelligent Computing},
pages = {80–86},
numpages = {7},
keywords = {RNA foundation model, long sequence modeling, state space models},
location = {
},
series = {BIC '26}
}

