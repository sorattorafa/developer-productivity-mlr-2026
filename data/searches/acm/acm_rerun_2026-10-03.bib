publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {Welcome to the third edition of the International Workshop on AI Solutions for Software Engineering Challenges in Financial Firms (FinanSE), held in conjunction with the 48th IEEE/ACM International Conference on Software Engineering (ICSE 2026) in Rio de Janeiro, Brazil. The FinanSE workshop took place on April 12, 2026.Software development has an integral role in every financial organization. Almost every service provided by a bank or a financial institution utilizes some form of software solution, often driven by artificial intelligence (AI). The FinanSE workshop aims to provide the SE community working on FinTech-relevant topics in both industry and academia with a unique opportunity to discuss such challenges and work in collaboration towards effective solutions.},
