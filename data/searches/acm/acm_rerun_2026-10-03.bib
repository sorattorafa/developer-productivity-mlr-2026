@inproceedings{10.1145/3803437.3806704,
author = {Ferino, Samuel and Hoda, Rashina and Grundy, John and Treude, Christoph},
title = {Towards an Appropriate Level of Reliance on AI: A Preliminary Reliance-Control Framework for AI in Software Engineering},
year = {2026},
isbn = {9798400726361},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3803437.3806704},
doi = {10.1145/3803437.3806704},
abstract = {How software developers interact with Artificial Intelligence (AI)-powered tools, including Large Language Models (LLMs), plays a vital role in how these AI-powered tools impact them. While overreliance on AI may lead to long-term negative consequences (e.g., atrophy of critical thinking skills); underreliance might deprive software developers of potential gains in productivity and quality. Based on twenty-two interviews with software developers on using LLMs for software development, we propose a preliminary reliance-control framework where the level of control can be used as a way to identify AI overreliance and underreliance. We also use it to recommend future research to further explore the different control levels supported by the current and emergent LLM-driven tools. Our paper contributes to the emerging discourse on AI overreliance and provides an understanding of the appropriate degree of reliance as essential to developers making the most of these powerful technologies. Our findings can help practitioners, educators, and policymakers promote responsible and effective use of AI tools.},
booktitle = {Proceedings of the 34th ACM International Conference on the Foundations of Software Engineering},
pages = {1795–1799},
numpages = {5},
keywords = {artificial intelligence, software development, developer tools, human-AI interaction, large language models},
location = {Concordia University, Montreal, QC, Canada},
series = {FSE Companion '26}
}

@inproceedings{10.1145/3785706.3785804,
author = {Wu, Chenrui and Zhu, Shunyu and Xu, Zhao},
title = {An Empirical Analysis of the Impact of Trade Policy Uncertainty on China's Economy and Electricity Consumption},
year = {2026},
isbn = {9798400719516},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3785706.3785804},
doi = {10.1145/3785706.3785804},
abstract = {Trade policy uncertainty (TPU) is a significant factor influencing China's economy and electricity consumption. Using monthly time-series data from 2017 to 2025, we estimate a time-varying parameter VAR (TVP-VAR) to examine, empirically, the impact of TPU on both variables. We find that trade-policy uncertainty, exemplified by the U.S.-China trade war, exerted a short-term depressive effect on China's economic growth and electricity use, with delayed adverse impacts emerging after approximately six months, and the effects returned to neutrality after one year. Notably, during the 2020-2022 pandemic period, global supply chain disruptions ultimately generated positive spillover effects for China through export substitution advantages lasting for about half a year to one year. A time-specific analysis further indicates that the economic pressure stemming from the U.S.-China trade war during Trump's first presidency lasted longer, whereas the impact of trade tensions in 2025 subsided more rapidly. Moreover, electricity consumption in China responds more quickly to TPU shocks than overall economic activity.},
booktitle = {Proceedings of the 2025 2nd International Conference on Digital Economy and Computer Science},
pages = {628–633},
numpages = {6},
keywords = {Economy, Electricity Consumption, TVP-VAR, Trade Policy Uncertainty},
location = {
},
series = {DECS '25}
}

@inproceedings{10.1145/3820915.3821056,
author = {Zeng, Qi and Chen, Yunlei and Wu, Fei and Mu, Rongbing},
title = {A Digital Twin-Driven Framework for Intelligent Sensing and Dynamic Assessment of Urban Public Health Environments},
year = {2026},
isbn = {9798400723612},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820915.3821056},
doi = {10.1145/3820915.3821056},
abstract = {With rapid urbanization, urban public health systems are increasingly characterized by multi-source coupling and dynamic evolution, posing challenges to traditional static indicator-based assessment approaches in capturing the processes of risk generation and propagation. To address this limitation, this study proposes a digital twin-driven framework for intelligent sensing and dynamic assessment of urban public health risk. By integrating multi-source data, constructing state variables, establishing virtual-physical mappings, and enabling dynamic risk evaluation, the framework supports continuous representation and process-oriented analysis of public health risk. The results indicate that urban public health risk is not governed by individual environmental factors, but emerges from the coupled interactions among environmental exposure, spatial density, and health sensitivity, exhibiting significant nonlinear amplification effects. Temporally, risk demonstrates path dependence and cumulative dynamics, characterized by persistence and delayed attenuation of high-risk states. Spatially, risk propagates along urban connectivity structures, forming diffusion patterns from localized clusters to outward spillover. Overall, this study reframes public health risk from a static outcome into a spatiotemporal evolutionary process, enabling a systematic understanding of risk generation mechanisms and transmission pathways, and providing a state-driven paradigm for dynamic risk assessment in complex urban systems.},
booktitle = {Proceedings of the 2nd International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
pages = {903–910},
numpages = {8},
keywords = {Digital Twin, Dynamic Assessment, Intelligent Sensing, Urban Public Health Risk, Urban Systems},
location = {
},
series = {AIVRID '26}
}

@inproceedings{10.1145/3783779.3783783,
author = {Liu, Mingyu},
title = {Attention-Mamba: Accurate Temporal Modeling for Stock Prediction},
year = {2026},
isbn = {9798400720932},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3783779.3783783},
doi = {10.1145/3783779.3783783},
abstract = {Stock price prediction is a central problem in financial engineering, where traditional time series models often fall short in capturing the complex, nonlinear dynamics inherent in market behavior. To address this limitation, this study introduces a novel hybrid architecture—Attention-Mamba—that integrates selective state space models with attention mechanisms. The resulting framework achieves high predictive accuracy while maintaining computational efficiency. Evaluated on constituent stocks of the CSI 300 index, the proposed model outperforms conventional time series forecasting approaches in accuracy, without incurring high computational costs. This work offers a new and efficient solution for modeling financial time series.},
booktitle = {Proceedings of the 2025 3rd International Conference on Mathematics and Machine Learning},
pages = {19–23},
numpages = {5},
keywords = {Attention Mechanism, Deep Learning, Mamba, Stock Price Prediction},
location = {
},
series = {ICMML '25}
}

@inproceedings{10.1145/3802842.3802871,
author = {Hou, Yumeng},
title = {Playing and Replay: The Body as Interface with Central African Traditions},
year = {2026},
isbn = {9798400725005},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3802842.3802871},
doi = {10.1145/3802842.3802871},
abstract = {As museums evolve from spaces of display to sites of engagement, the curatorial challenge of working with intangible cultural forms – often entwined with bodily and spiritual practices – assumes heightened significance. This article reflects on interactive installations created for an exhibition on Central African arts, exploring how body-centred digital mediation can re-present artefacts not as static symbols, but as relational, living encounters with people’s practices and memories. Through processes of transfiguration, reconstruction, and reenactment, the installations cultivate zones of sensory and spiritual liminality, where participants glide between player and enactor, spectator and mediator, becoming part of the experience. Viewing transforms into acts and spectacles of play, through which memories are awakened and inhabited anew.},
booktitle = {Proceedings of the 10th International Conference on Movement and Computing},
articleno = {42},
numpages = {7},
keywords = {embodied interaction; digital reconstruction; reenactment; performative museum; central africa},
location = {
},
series = {MOCO '26}
}

@inproceedings{10.1145/3793828.3793832,
author = {Perboli, Guido and Gentili, Federica and Gajetti, Marco},
title = {Data Spaces and Blockchain as Enablers of a Sustainable Data Lifecycle in the Metaverse},
year = {2026},
isbn = {9798400723384},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3793828.3793832},
doi = {10.1145/3793828.3793832},
abstract = {The paper explores how data spaces and blockchain technologies can support a sustainable data lifecycle in the Metaverse. The paper emphasizes the need for a multi-actor environment to enable an effective data economy. We frame the discussion within the context of the Nous project.},
booktitle = {Proceedings of the 2026 International Conference on Infrastructure-as-a-Service (IaaS) and Platform-as-a-Service (PaaS) Solutions for Europe's Next-Gen Cloud Infrastructure},
