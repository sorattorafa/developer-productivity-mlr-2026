series = {APIT '26}
}

@inproceedings{10.1145/3820664.3820673,
author = {Chen, Weiyu and He, Yong and Zhu, Bin and Cui, Zhenhe},
title = {Coverage-Aware Windowed mdBG Assembly},
year = {2026},
isbn = {9798400722653},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820664.3820673},
doi = {10.1145/3820664.3820673},
abstract = {Genome assembly reconstructs large collections of sequencing reads into contiguous sequences, serving as a central computational stage in modern genomics. Among de Bruijn graph (dBG) assemblers, the minimizer-space dBG (mdBG) improves speed and reduces memory usage by compressing reads into minimizer sequences. However, the universe-minimizer sampling in the original mdBG framework is locally nonuniform, which can create random coverage holes that weaken graph connectivity and contiguity. To address this, this study replaces the universe minimizer with a windowed minimizer that enforces a strict window guarantee—selecting at least one minimizer within every sliding window of w consecutive ℓ-mers—thereby imposing an upper bound on the spacing between adjacent minimizers. Coupled with coverage-aware abundance filtering and graph simplification, the windowed mdBG improves assembly performance without adding computational overhead. On two PacBio HiFi datasets, the proposed method increased the N50 from 4.90 to 8.64 Mbp on D. melanogaster, and improved the NGA50 from 4.71 to 5.99 Mbp and the genome fraction from 86% to 93% on A. thaliana, all while keeping runtime and peak memory comparable to the original mdBG.},
booktitle = {Proceedings of the 2026 2nd International Symposium on Bioinformatics and Computational Biology},
pages = {60–67},
numpages = {8},
keywords = {Bioinformatics, De Bruijn Graphs, Genome Assembly, Long-read Sequencing, Minimizers, PacBio HiFi},
location = {
},
series = {ISBCB '26}
}

