abstract = {This paper presents the development and implementation of an impedance control framework to control a dual 7 Degrees of Freedom (DoF) arms robot, i.e., true humanoid arms for synchronized motion, task-space compliance, and adaptability to unknown environmental interaction forces. The proposed approach ensures stable, compliant, and coordinated interaction with objects, robots, and humans, achieving robust performance in dynamic environments. Experimental results from simulation demonstrate the efficacy of the proposed framework in tasks involving arms-synchronization for trajectory tracking, along with compliance towards disturbance generated from unknown environmental interaction forces. The contributions of this work significantly enhance the potential of the dual 7-DoF arms robot.},
booktitle = {Proceedings of the 2025 7th International Conference on Advances in Robotics},
