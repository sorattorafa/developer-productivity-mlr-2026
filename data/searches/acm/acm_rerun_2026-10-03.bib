publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
abstract = {The special theme of AST 2026 is "Adapting test automation to the AI era including sustainability and emerging challenges". We are seeing that the AI era is causing a transformative shift in test automation, revolutionizing traditional approaches and enhancing efficiency, accuracy, and adaptability. This integration of AI and machine learning introduces intelligent test case generation, self-healing test scripts, and predictive analytics. These advances have the potential to significantly reduce testing time, while improving overall software quality. The role of testers will evolve from test script writers to strategic overseers, focusing on test design, data and quality interpretation, and critical problem-solving. As AI takes on repetitive tasks, it allows for more comprehensive test coverage, including the identification of edge cases that human testers might overlook. The future of test automation lies in agent-like testing systems that learn continuously, adapt to changes, and provide deeper insights into software quality, ultimately leading to faster, more reliable software delivery in an increasingly complex digital landscape.},
location = {
}
}

@article{10.1145/3832290,
author = {Liu, Jiawei and Lin, Yun and Liu, Chenyan and Qian, Yu and Liu, Yiming and Chang, Jiaxin and Zhang, Weinan and Huang, Linpeng},
title = {IssueExec: A Test-Driven Approach for Localizing Software Engineering Issues},
year = {2026},
issue_date = {October 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {3},
number = {ISSTA},
url = {https://doi.org/10.1145/3832290},
doi = {10.1145/3832290},
abstract = {Issue localization, which identifies code locations requiring modification from issue descriptions, is a critical step in automated software maintenance. Existing approaches predominantly attempt to directly align issue descriptions with code elements, yet often struggle due to the inherent abstraction gap between the issue description and code implementation. Seeking alternative signals, our theoretical analysis suggests that test suites can serve as executable proxies for requirements, reducing localization uncertainty by 7.73 bits of entropy on average. A large-scale empirical study on 18 repositories validates this premise: existing tests cover 96.98% of ground-truth files, and the two-hop pathway yields stronger semantic connectivity than direct matching in 82.4% of cases. Despite their potential, leveraging tests for localization faces two key challenges: the semantic gap separating issue descriptions from test identifiers, and the substantial noise in execution traces from infrastructure code. To address these, we propose IssueExec, which bridges the semantic gap through domain-knowledge-enhanced test representations and filters noise via hierarchical trace analysis. Experiments on SWE-bench Lite show that IssueExec achieves state-of-the-art performance, improving function-level Recall@1 by 41.57% over the strongest baseline. When integrated into the Agentless pipeline, IssueExec resolves 17.72% more issues, demonstrating practical downstream benefits.},
journal = {Proc. ACM Softw. Eng.},
month = oct,
articleno = {ISSTA199},
numpages = {22},
keywords = {Issue Localization, Test-driven Analysis}
}

@inproceedings{10.1145/3830418.3843898,
author = {Goodwin, Tim and Kuper, Lindsey and Quinn, Andi},
title = {Testing Custom Control Planes Without the Cluster},
year = {2026},
isbn = {9798400725852},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3830418.3843898},
doi = {10.1145/3830418.3843898},
abstract = {Modern cloud infrastructure is increasingly managed by software. On platforms like Kubernetes, the control plane maintains desired system state through controllers: software components that continuously monitor cluster resources and reconcile them toward a declared specification. This pattern has proven effective, and a thriving ecosystem of projects now compose controllers into custom control planes (CCPs) to automate tasks such as managing application delivery, scaling infrastructure dynamically, and composing cloud provider APIs into higher-level abstractions. The correctness of a CCP, however, depends on how its constituent controllers interact at run time. Bugs arise from implicit assumptions about these interactions that do not hold under all possible executions. As such, finding them requires enumerating the space of possible executions and searching it systematically, which is infeasible in a live cluster environment. In this paper, we present Kamera, a system for testing CCPs that uses partial simulation to execute the code of multiple interacting controllers against a lightweight model of the Kubernetes runtime. Thus far, Kamera has found 31 new bugs in five popular CCP projects and achieves a 1,781{\texttimes} speedup over existing cluster-based controller testing approaches.},
booktitle = {Proceedings of the ACM SIGOPS 32nd Symposium on Operating Systems Principles},
pages = {955–970},
numpages = {16},
keywords = {Kubernetes, cluster management, simulation testing, controllers, control plane, cloud infrastructure, reliability},
location = {
},
series = {SOSP '26}
}

